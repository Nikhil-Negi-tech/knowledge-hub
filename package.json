{
  "name": "knowledge-hub",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "set PRISMA_HIDE_UPDATE_MESSAGE=true&& set PRISMA_GENERATE_NO_WARNINGS=true&& prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.0.0",
    "lucide-react": "^0.400.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.13.0",
    "prisma": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
